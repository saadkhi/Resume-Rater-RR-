# Server Configuration
PORT=3000
NODE_ENV=production

# Vercel Deployment (Vercel automatically sets VERCEL=1)
# VERCEL=1

# Application Base URL (Used for checkout return URLs)
# APP_URL=https://your-project.vercel.app

# Optional AI Features
GEMINI_API_KEY=

# Paddle Billing Configuration ($5/mo & $39/yr)
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO_MONTHLY=pri_pro_monthly_5usd
PADDLE_PRICE_ID_PRO_ANNUAL=pri_pro_annual_39usd

# Server Configuration
PORT=3000
NODE_ENV=production

# Vercel Deployment (Vercel automatically sets VERCEL=1)
# VERCEL=1

# Application Base URL (Used for Stripe checkout return URLs)
# APP_URL=https://your-project.vercel.app

# Optional AI Features
GEMINI_API_KEY=

# Stripe Subscription Configuration ($5/mo & $39/yr)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly_5usd
STRIPE_PRICE_ID_PRO_ANNUAL=price_pro_annual_39usd
